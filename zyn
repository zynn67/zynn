-- ===================== FORCE KICK (car seat desync) =====================
-- Ownership handling is the extracted ForceKick (feariosz0) version:
--   * every executor entry point is resolved through getfenv()/getgenv()/_G
--     before the bare global
--   * SimulationRadius is pushed with MaximumSimulationRadius + setsimulationradius
--   * the owned part is bound to the victim with sethiddenproperty
--     PhysicsRepRootPart + PhysicsRepRootRef (InstanceHandle), then flung with
--     BasePart.Velocity, which is still live as an alias of AssemblyLinearVelocity
--
-- There is no ownership poll any more. The extracted script waits for
-- isnetworkowner() to confirm the car before it does anything, which on a car
-- this client never owns serialises into a multi-second stall (and its repeat
-- loop never even re-reads the flag). Here the seat is bound straight to the
-- target's HumanoidRootPart and parked on them the moment it spawns.
--
-- The car is driven in and then parked with the driver seat sitting exactly on
-- the target's HumanoidRootPart, with no distance gate: a VehicleSeat takes the
-- humanoid touching it as its Occupant, so parking is what seats them. Two
-- triggers arm the kick, because they are the same event:
--   * seat.Touched with any part of the target's character, and
--   * seat.Occupant reporting the target
-- Both are only ever acted on when seat.Occupant says the server really put the
-- target in this seat. Humanoid.SeatPart is client-local, and a seat that only
-- exists on our screen would otherwise arm the kick and have the throw resolve
-- against the kicker instead of the target.
-- A target who is already sitting in a car never reaches this path at all: the
-- seat check at the top of startKick sends them to the normal passenger kick.
--
-- Only when one of those triggers fires is the kicker reset, and only after the
-- reset settles is any throw velocity written, so the car's physics root is
-- never resolved against a live kicker assembly. That ordering is what stopped
-- the kick landing on the kicker in the original script. The animation is
-- cosmetic and fires alongside the reset.
--
-- Sitting the target in the driver seat is not enough on its own. The desync is
-- a seat-weld break between occupants of one car, which is why doCarKickOnce is
-- welded into a passenger seat before it dies. So at trigger the kicker is
-- seated in a free passenger seat of the same car, and only then is it reset.
-- Without that weld the break has nothing to act on and the throw resolves
-- against the kicker's own body.

local KICK_ANIM_ID   = 'rbxassetid://148840371'
local KICK_ANIM_TIME = 1
local RESET_SETTLE   = 0.5  -- seconds allowed for the reset to register before the throw
local FLING_VELOCITY = Vector3.new(10000, 10000, 10000)
local RAM_SPEED      = 1400  -- studs/second the seat is carried in at while it is still far
local RAM_RANGE      = 2     -- studs: inside this the seat is parked on the target instead
local RAM_SPIN       = Vector3.new(0, 140, 0)

local KickState = {
    Enabled = false,
    StopFlag = false,
    Running = false,
    OriginalCF = nil,
    RespawnConn = nil,
    FlingConn = nil,
    SimConn = nil,
    SpawnedCar = nil,
    OwnedSeat = nil,
    OwnerSource = nil,
    RamStarted = false,
    Contact = false,
    KickDone = false,
    KickAnimStarted = false,
    ContactConn = nil,
}

-- ── executor surface, resolved the ForceKick way ─────────────────────────────
local function resolveFn(name)
    local ok, fn = pcall(function()
        local env = getfenv and getfenv(0)
        return env and env[name]
    end)
    if ok and typeof(fn) == 'function' then return fn end

    local genv = getgenv and getgenv()
    if genv and typeof(genv[name]) == 'function' then return genv[name] end
    if typeof(_G[name]) == 'function' then return _G[name] end

    return nil
end

local function setMaxSimRadius()
    local sethidden = resolveFn('sethiddenproperty')
    local setsim    = resolveFn('setsimulationradius')

    if sethidden then
        pcall(sethidden, LP, 'SimulationRadius', 1e9)
        pcall(sethidden, LP, 'MaximumSimulationRadius', 1e9)
        pcall(sethidden, LP, 'MaxSimulationRadius', 1e9)
    end
    if setsim then
        pcall(setsim, 1e9)
    end
end

