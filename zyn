local calculateModifiedFireRate

do
    local baseRate = {
        ['AK-47']         = 0.1,
        ['M4A1']          = 0.09,
        ['FAL']           = 0.095,
        ['MP5']           = 0.1,
        ['M9']            = 0.12,
        ['Revolver']      = 0.3,
        ['M700']          = 0.2,
        ['Remington 870'] = 0.7,
        ['Taser']         = 0.1,
    }
    local baseAuto = {
        ['AK-47']         = true,
        ['M4A1']          = true,
        ['FAL']           = true,
        ['MP5']           = true,
        ['M9']            = false,
        ['Revolver']      = false,
        ['M700']          = false,
        ['Remington 870'] = false,
        ['Taser']         = false,
    }

    local gunList = LB_GUN_MOD_GUNS or { 'AK-47', 'Remington 870', 'M9', 'M700', 'M4A1', 'FAL', 'MP5', 'Revolver' }

    local function requestedRate()
        return math.clamp((Options.GunModFireRate and Options.GunModFireRate.Value) or 0.05, 0.01, 0.5)
    end

    calculateModifiedFireRate = function(toolName, baseFireRate)
        if not (Toggles.GunModEnabled and Toggles.GunModEnabled.Value) then
            return baseFireRate
        end
        if not (Toggles.GunModFastFire == nil or Toggles.GunModFastFire.Value) then
            return baseFireRate
        end
        if baseRate[toolName] == nil then
            return baseFireRate
        end
        return requestedRate()
    end

    local propsCache = nil

    local function getToolProps()
        if propsCache ~= nil then return propsCache end
        local shared = game:GetService('ReplicatedStorage'):FindFirstChild('SharedModules')
        local props = shared and shared:FindFirstChild('ToolProperties')
        if not props then return nil end
        local ok, result = pcall(require, props)
        if ok and type(result) == 'table' then
            propsCache = result
        end
        return propsCache
    end

    local function forceAutoEnabled()
        return Toggles.GunModAutoFire and Toggles.GunModAutoFire.Value
    end

    local function patchProps()
        local props = getToolProps()
        if not props then return end
        for _, gunName in ipairs(gunList) do
            local entry = props[gunName]
            if type(entry) == 'table' then
                entry.FireRate = calculateModifiedFireRate(gunName, baseRate[gunName] or entry.FireRate or 0.1)
                if forceAutoEnabled() then
                    entry.AutoFire = true
                else
                    entry.AutoFire = baseAuto[gunName]
                end
            end
        end
    end

    local function patchTool(tool)
        if not tool or not tool:IsA('Tool') then return end
        if baseRate[tool.Name] == nil then return end
        tool:SetAttribute('FireRate', calculateModifiedFireRate(tool.Name, baseRate[tool.Name]))
        if forceAutoEnabled() then
            tool:SetAttribute('AutoFire', true)
        else
            tool:SetAttribute('AutoFire', baseAuto[tool.Name])
        end
    end

    local function refreshGunMods()
        patchProps()
        local char = LP.Character
        if char then
            for _, child in ipairs(char:GetChildren()) do
                patchTool(child)
            end
        end
        local bp = LP:FindFirstChildOfClass('Backpack') or LP:FindFirstChild('Backpack')
        if bp then
            for _, child in ipairs(bp:GetChildren()) do
                patchTool(child)
            end
        end
    end

    for _, toggle in ipairs({ Toggles.GunModEnabled, Toggles.GunModFastFire, Toggles.GunModAutoFire }) do
        if toggle then toggle:OnChanged(refreshGunMods) end
    end
    if Options.GunModFireRate then Options.GunModFireRate:OnChanged(refreshGunMods) end

    local function hookContainer(container)
        if not container then return end
        container.ChildAdded:Connect(function(child)
            task.defer(patchTool, child)
        end)
    end

    hookContainer(LP.Character)
    hookContainer(LP:FindFirstChild('Backpack'))
    LP.CharacterAdded:Connect(function(char)
        hookContainer(char)
        task.delay(0.5, function()
            hookContainer(LP:FindFirstChild('Backpack'))
            refreshGunMods()
        end)
    end)

    task.delay(0.5, refreshGunMods)
end

