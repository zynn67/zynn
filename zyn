local WB_OFF_A = {
    Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
    Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(0, -1, 0),
    Vector3.new(0.7, 0.5, 0.5), Vector3.new(-0.7, 0.5, 0.5),
}
local WB_OFF_B = {
    Vector3.new(0, 3, 0), Vector3.new(0, 5, 0), Vector3.new(0, 7, 0),
    Vector3.new(1, 3, 0), Vector3.new(-1, 3, 0),
    Vector3.new(0, 3, 1), Vector3.new(0, 3, -1), Vector3.new(0, 10, 0),
}

function OriginScanner:Scan(fromPos, aimPos, targetPart)
    if targetPart and self.Cache[targetPart] then
        return table.unpack(self.Cache[targetPart])
    end

    local flatMask = Vector3.new(1, 0, 1)
    local look = CFrame.lookAt(fromPos * flatMask, aimPos * flatMask).LookVector

    -- target-side hitboxes (Inhaler: RootPart + Normal * 7.4, includes Up/Down)
    local rootPos = aimPos
    if targetPart and targetPart.Parent then
        local hrp = targetPart.Parent:FindFirstChild('HumanoidRootPart')
        if hrp then rootPos = hrp.Position end
    end

    local aims = { aimPos }
    for _, n in ipairs(Enum.NormalId:GetEnumItems()) do
        local v = Vector3.FromNormalId(n)
        -- prefer sides facing the shooter, but still allow full vertical
        if (v * flatMask):Dot(-look) > -0.5 or math.abs(v.Y) > 0.5 then
            local a = rootPos + v * 7.4
            if wbIsFree(a) then
                table.insert(aims, a)
            end
        end
    end
    -- extra vertical bias for floors / roofs
    for _, y in ipairs({ -1.5, -2.5, 1.2, 2.0 }) do
        local a = aimPos + Vector3.new(0, y, 0)
        if wbIsFree(a) then
            table.insert(aims, a)
        end
    end

    -- shooter-side origins (Inhaler: fromPos + offset * 6, includes Up/Down)
    local origins = { fromPos }
    local shooterOffsets = {
        Vector3.new(0, 1, 0), Vector3.new(0, -1, 0),
        Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0),
        Vector3.new(0, 0, 1), Vector3.new(0, 0, -1),
        Vector3.new(0.7, -0.5, -0.5), Vector3.new(-0.8, -0.5, -0.5),
        Vector3.new(0.7, 0.5, 0.5), Vector3.new(-0.8, 0.4, 0.4),
        Vector3.new(0.7, 0, -0.8), Vector3.new(-0.8, 0, -0.8),
        Vector3.new(0.7, 0.4, -0.5), Vector3.new(-0.8, -0.5, 0.4),
    }
    for _, o in ipairs(shooterOffsets) do
        if (o * flatMask):Dot(look) > -0.5 or math.abs(o.Y) > 0.5 then
            local p = fromPos + o * 6
            if wbIsFree(p) then
                table.insert(origins, p)
            end
        end
    end

    -- Inhaler order: every hitbox → every origin, first clear ray wins
    for _, a in ipairs(aims) do
        for _, o in ipairs(origins) do
            if wbIsFree(o) and not Workspace:Raycast(a, o - a, self.Ray) then
                if targetPart then
                    self.Cache[targetPart] = { o, a }
                end
                return o, a
            end
        end
    end

    return nil
end

local function getWallbangOrigin(fromPos, aimPos, targetPart)
    local o, hit = OriginScanner:Scan(fromPos, aimPos, targetPart)
    if o then
        return o, hit or aimPos
    end

    -- vertical fallbacks when Scan finds nothing
    local dy = aimPos.Y - fromPos.Y
    if dy > 4 then
        -- under them (floor)
        return aimPos + Vector3.new(0, -1.5, 0), aimPos
    elseif dy < -4 then
        -- above them (roof)
        return aimPos + Vector3.new(0, 1.2, 0), aimPos
    end

    return aimPos + Vector3.new(0, -1.2, 0), aimPos
end

