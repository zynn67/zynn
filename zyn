-- ========== FIRE RATE ==========
local FireRateEnabled = false
local DesiredFireRate = 0.05
local ForceAutoFire = true

local function applyFireRate(tool)
	if not tool or not tool:IsA("Tool") then return end
	if tool:GetAttribute("ToolType") ~= "Gun" then return end
	if FireRateEnabled then
		tool:SetAttribute("FireRate", DesiredFireRate)
		if ForceAutoFire then
			tool:SetAttribute("AutoFire", true)
		end
	end
end

local function onCharacterFireRate(char)
	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") then applyFireRate(child) end
	end
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute("ToolType") == "Gun" then
			task.defer(function() applyFireRate(child) end)
			local conn
			conn = RunService.Heartbeat:Connect(function()
				if not child.Parent or child.Parent ~= char then
					conn:Disconnect()
					return
				end
				if FireRateEnabled then applyFireRate(child) end
			end)
		end
	end)
end

if player.Character then onCharacterFireRate(player.Character) end
player.CharacterAdded:Connect(onCharacterFireRate)

local function SetFireRateEnabled(state)
	FireRateEnabled = state
	local char = player.Character
	if char then
		for _, tool in ipairs(char:GetChildren()) do
			if tool:IsA("Tool") then applyFireRate(tool) end
		end
	end
end

local function SetFireRateValue(value)
	DesiredFireRate = math.clamp(value, 0.01, 0.5)
	if FireRateEnabled then SetFireRateEnabled(true) end
end

local function SetForceAutoFire(state)
	ForceAutoFire = state
	if FireRateEnabled then SetFireRateEnabled(true) end
end

-- ========== WORKING SILENT AIM (ShootEvent hook) ==========
local SilentAim = {
	Enabled = false,
	HitPart = "Head",
	Range = 500,
	HitChance = 100,
	FOV = 120,
	ShowFOV = false,
	TeamCheck = true,
}

local currentTarget = nil
local FOVCircle = nil

pcall(function()
	FOVCircle = Drawing.new("Circle")
	FOVCircle.Thickness = 1.5
	FOVCircle.NumSides = 64
	FOVCircle.Radius = SilentAim.FOV
	FOVCircle.Filled = false
	FOVCircle.Color = Color3.fromRGB(255, 140, 0)
	FOVCircle.Visible = false
end)

local function isValidTarget(plr)
	if not plr or plr == player then return false end
	local char = plr.Character
	if not char then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	if char:FindFirstChildOfClass("ForceField") then return false end

	if SilentAim.TeamCheck then
		if plr.Team and player.Team and plr.Team == player.Team then return false end
		if player.Team and player.Team.Name == "Guards" and plr.Team and plr.Team.Name == "Inmates" then
			if not char:GetAttribute("Hostile") then return false end
		end
	end
	return true
end

local function worldToScreen(pos)
	local cam = Workspace.CurrentCamera
	local screen, onScreen = cam:WorldToViewportPoint(pos)
	return Vector2.new(screen.X, screen.Y), onScreen, screen.Z
end

local function getClosestTarget()
	local cam = Workspace.CurrentCamera
	local mousePos = UserInputService:GetMouseLocation()
	local closest, closestDist = nil, SilentAim.FOV

	for _, plr in ipairs(Players:GetPlayers()) do
		if isValidTarget(plr) then
			local part = plr.Character:FindFirstChild(SilentAim.HitPart)
				or plr.Character:FindFirstChild("Head")
				or plr.Character:FindFirstChild("HumanoidRootPart")
			if part then
				local screenPos, onScreen, depth = worldToScreen(part.Position)
				if onScreen and depth > 0 then
					local distFromMouse = (screenPos - mousePos).Magnitude
					local worldDist = (cam.CFrame.Position - part.Position).Magnitude
					if distFromMouse <= SilentAim.FOV and worldDist <= SilentAim.Range then
						if distFromMouse < closestDist then
							closestDist = distFromMouse
							closest = plr
						end
					end
				end
			end
		end
	end
	return closest
end

local function shouldHit()
	return math.random(1, 100) <= SilentAim.HitChance
end

RunService.RenderStepped:Connect(function()
	if FOVCircle then
		local mouse = UserInputService:GetMouseLocation()
		FOVCircle.Position = mouse
		FOVCircle.Radius = SilentAim.FOV
		FOVCircle.Visible = SilentAim.ShowFOV and SilentAim.Enabled
		FOVCircle.Color = currentTarget and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 140, 0)
	end
	if SilentAim.Enabled then
		currentTarget = getClosestTarget()
	else
		currentTarget = nil
	end
end)

-- Hook the real ShootEvent (from GunController)
local GunRemotes = ReplicatedStorage:FindFirstChild("GunRemotes")
local ShootEvent = GunRemotes and GunRemotes:FindFirstChild("ShootEvent")

if ShootEvent then
	local oldFireServer
	oldFireServer = hookfunction(ShootEvent.FireServer, function(self, data, ...)
		if SilentAim.Enabled and currentTarget and shouldHit() then
			local char = currentTarget.Character
			local part = char and (char:FindFirstChild(SilentAim.HitPart)
				or char:FindFirstChild("Head")
				or char:FindFirstChild("HumanoidRootPart"))
			if part and typeof(data) == "table" then
				for _, shot in ipairs(data) do
					if typeof(shot) == "table" then
						shot[2] = part.Position -- redirect hit position
						shot[3] = part
					end
				end
			end
		end
		return oldFireServer(self, data, ...)
	end)
	print("[Silent Aim] ShootEvent hooked")
else
	warn("[Silent Aim] GunRemotes.ShootEvent not found")
end

-- Backup mouse hook (helps tracers)
pcall(function()
	local oldGetMouseLocation
	oldGetMouseLocation = hookfunction(UserInputService.GetMouseLocation, function(self)
		if SilentAim.Enabled and currentTarget and shouldHit() then
			local part = currentTarget.Character
				and (currentTarget.Character:FindFirstChild(SilentAim.HitPart)
					or currentTarget.Character:FindFirstChild("Head"))
			if part then
				local screenPos, onScreen = worldToScreen(part.Position)
				if onScreen then return screenPos end
			end
		end
		return oldGetMouseLocation(self)
	end)
end)

