local function pushToggles()
	pcall(function() if onDeathToggle and onDeathToggle.Set then onDeathToggle:Set(autoOnDeath) end end)
	pcall(function() if ffToggle and ffToggle.Set then ffToggle:Set(ffReset) end end)
end

