-- ── world helpers ────────────────────────────────────────────────────────────
local function getTargetCar(plr)
    local char = plr and plr.Character
    local hum  = char and char:FindFirstChildOfClass('Humanoid')
    local seat = hum and hum.SeatPart
    if not seat or not seat:IsA('VehicleSeat') then return nil, nil end
    local model = seat:FindFirstAncestorOfClass('Model')
    while model and model.Parent and model.Parent:IsA('Model') and model.Parent ~= Workspace do
        model = model.Parent
    end
    return model, seat
end

local function findPassengerSeat(model, driverSeat)
    local fallback = nil
    for _, item in ipairs(model:GetDescendants()) do
        if item ~= driverSeat
            and (item:IsA('Seat') or item:IsA('VehicleSeat'))
            and not item.Occupant
            and not item.Disabled
        then
            if item:IsA('Seat') and not item:IsA('VehicleSeat') then
                return item
            end
            fallback = fallback or item
        end
    end
    return fallback
end

local function returnToKickStart(character)
    if not KickState.OriginalCF then return end
    local root = character:WaitForChild('HumanoidRootPart', 8)
    local hum  = character:WaitForChild('Humanoid', 8)
    if not root or not hum then return end
    local t0 = os.clock()
    while KickState.Enabled and os.clock() - t0 < 1.6 and hum.Health > 0 do
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = KickState.OriginalCF
        task.wait()
    end
end

-- ── passenger desync (target is already driving) ─────────────────────────────
local function doCarKickOnce(target)
    local myChar = LP.Character
    local myHum  = myChar and myChar:FindFirstChildOfClass('Humanoid')
    local myRoot = myChar and myChar:FindFirstChild('HumanoidRootPart')
    if not (myChar and myHum and myRoot) or myHum.Health <= 0 then return false end

    local car, driverSeat = getTargetCar(target)
    if not car then return false end
    local passengerSeat = findPassengerSeat(car, driverSeat)
    if not passengerSeat then return false end

    local t0 = os.clock()
    while KickState.Enabled
        and LP.Character == myChar
        and myHum.Health > 0
        and myHum.SeatPart ~= passengerSeat
        and os.clock() - t0 < 3.2
    do
        pcall(function()
            myRoot.CFrame = passengerSeat.CFrame * CFrame.new(0, 2, 0)
            passengerSeat:Sit(myHum)
        end)
        task.wait()
    end

    if not KickState.Enabled or myHum.SeatPart ~= passengerSeat then
        return false
    end

    local track
    pcall(function()
        local anim = Instance.new('Animation')
        anim.AnimationId = KICK_ANIM_ID
        track = myHum:LoadAnimation(anim)
        track.Looped = true
        track:Play()
    end)
    task.wait(KICK_ANIM_TIME)
    pcall(function()
        if track then track:Stop() end
        myHum.Health = 0
        myChar:BreakJoints()
    end)
    return true
end

-- ── bind an owned part to the victim (ForceKick's own fling) ─────────────────
-- Only the physics root and the velocity: the seat's position is handled by
-- ramTarget() below, otherwise every part in the loop would fight over it.
-- fling == false leaves the assembly's velocity alone, which is what the
-- approach phase needs so ramTarget() stays the only writer of where it goes.
-- Nothing in here ever accepts the kicker's root: that is deliberate.
local function bindOwnedPartToTarget(part, seat, target, fling)
    if not (part and part.Parent) then return false end

    local freshChar = target and target.Character
    local freshHum  = freshChar and freshChar:FindFirstChildOfClass('Humanoid')
    local freshRoot = freshHum and (freshHum.RootPart or freshChar:FindFirstChild('HumanoidRootPart'))
    if not freshRoot then return false end

    local sethidden = resolveFn('sethiddenproperty')
    local canHandle = typeof(InstanceHandle) == 'table' or typeof(InstanceHandle) == 'function'

    pcall(function()
        setMaxSimRadius()

        if sethidden then
            pcall(sethidden, part, 'PhysicsRepRootPart', freshRoot)
            if canHandle then
                pcall(sethidden, part, 'PhysicsRepRootRef', InstanceHandle.new(freshRoot))
            end
        end

        if fling ~= false then
            part.Velocity = FLING_VELOCITY
            pcall(function() part.AssemblyLinearVelocity = FLING_VELOCITY end)
        end
    end)

    return true
end

-- ── park the driver seat on the target ───────────────────────────────────────
-- No distance gate remains: while the car is still far it is carried in at
-- RAM_SPEED, and inside RAM_RANGE the seat is placed at the target's
-- HumanoidRootPart and held there every frame. A VehicleSeat takes the humanoid
-- touching it as its Occupant, so parking is what actually puts them in the
-- driver seat, and Touched fires on that same contact.
-- Setting this seat's CFrame sets where the whole welded car sits.
-- Returns true when the seat could be placed.
local function ramTarget(seat, target)
    local freshChar = target and target.Character
    local freshHum  = freshChar and freshChar:FindFirstChildOfClass('Humanoid')
    local freshRoot = freshHum and (freshHum.RootPart or freshChar:FindFirstChild('HumanoidRootPart'))
    if not freshRoot or freshHum.Health <= 0 then return false end

    local toVictim = freshRoot.Position - seat.Position
    local dist = toVictim.Magnitude
    local dir = dist > 0.01 and toVictim.Unit or Vector3.new(0, 0, -1)

    pcall(function()
        if dist > RAM_RANGE then
            -- still coming in: line the car up just short of them, nose first
            seat.CFrame = CFrame.lookAt(freshRoot.Position - dir * RAM_RANGE, freshRoot.Position)
            seat.Velocity = dir * RAM_SPEED
            seat.AssemblyLinearVelocity = dir * RAM_SPEED
            seat.AssemblyAngularVelocity = RAM_SPIN
        else
            -- parked: sit the seat on their HumanoidRootPart and hold it there
            seat.CFrame = CFrame.new(freshRoot.Position) * seat.CFrame.Rotation
            seat.Velocity = Vector3.zero
            seat.AssemblyLinearVelocity = Vector3.zero
            seat.AssemblyAngularVelocity = Vector3.zero
        end
    end)

    return true
end

-- ── the kick ─────────────────────────────────────────────────────────────────
-- Split into two steps so the order is explicit, because the order is the whole
-- point: reset first, then throw.
--
-- resetKicker() is synchronous. When it returns, the humanoid is dead and the
-- joints are broken, so by the time the Heartbeat is allowed to write throw
-- velocity there is no live kicker assembly for the car's physics root to
-- resolve against. animateKick() is cosmetic: it starts the track and returns
-- immediately instead of holding the throw behind the animation.
local function animateKick(char, hum)
    local track
    pcall(function()
        local anim = Instance.new('Animation')
        anim.AnimationId = KICK_ANIM_ID
        track = hum:LoadAnimation(anim)
        track.Looped = true
        track:Play()
    end)

    task.delay(KICK_ANIM_TIME, function()
        pcall(function() if track then track:Stop() end end)
    end)
end

local function resetKicker()
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass('Humanoid')
    if not char or not hum or hum.Health <= 0 then return false end

    animateKick(char, hum)

    pcall(function()
        hum.Health = 0
        char:BreakJoints()
    end)

    return true
end

local function stopKick()
    KickState.Enabled = false
    KickState.Running = false
    KickState.StopFlag = true
    KickState.RamStarted = false
    KickState.Contact = false
    KickState.KickDone = false
    KickState.KickAnimStarted = false
    if KickState.ContactConn then
        KickState.ContactConn:Disconnect()
        KickState.ContactConn = nil
    end
    if KickState.RespawnConn then
        KickState.RespawnConn:Disconnect()
        KickState.RespawnConn = nil
    end
    if KickState.FlingConn then
        KickState.FlingConn:Disconnect()
        KickState.FlingConn = nil
    end
    if KickState.SimConn then
        KickState.SimConn:Disconnect()
        KickState.SimConn = nil
    end
    KickState.SpawnedCar = nil
    KickState.OwnedSeat = nil
    KickState.OwnerSource = nil
end

-- ── force path: spawn a car, park it on the target, kick on contact ─────────
local function startKick(target)
    if not target or target == LP then return false, 'invalid' end
    if KickState.Enabled then
        stopKick()
        return false, 'stopped'
    end

    stopKick()
    KickState.StopFlag = false
    KickState.Enabled = true

    local myRoot = getRoot()
    if myRoot then KickState.OriginalCF = myRoot.CFrame end

    -- continuous SimulationRadius push
    KickState.SimConn = RunService.Heartbeat:Connect(setMaxSimRadius)

    task.spawn(function()
        -- team prep for the force path
        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild('Remotes')
            local rtc = remotes and remotes:FindFirstChild('RequestTeamChange')
            if rtc and LP.Team and LP.Team.Name == 'Criminals' then
                rtc:InvokeServer(Teams.Neutral, 1)
            end
            if rtc then
                local guard = Teams:FindFirstChild('Guards')
                local inmate = Teams:FindFirstChild('Inmates')
                local n = 0
                while n < 20 and LP.Team and LP.Team.Name == 'Criminals' do
                    if guard then rtc:InvokeServer(guard, 1) end
                    task.wait()
                    if inmate then rtc:InvokeServer(inmate, 1) end
                    n = n + 1
                end
            end
        end)

        -- seat check: the target is already sitting in a car of their own, so
        -- the normal passenger kick is the one that applies
        local car = select(1, getTargetCar(target))
        if car then
            if KickState.RespawnConn then KickState.RespawnConn:Disconnect() end
            KickState.RespawnConn = LP.CharacterAdded:Connect(function(newChar)
                if KickState.Enabled then returnToKickStart(newChar) end
            end)

            while KickState.Enabled and target.Parent == Players do
                local myChar = LP.Character
                local myHum  = myChar and myChar:FindFirstChildOfClass('Humanoid')
                if myHum and myHum.Health > 0 and not KickState.Running then
                    KickState.Running = true
                    local ok, result = pcall(doCarKickOnce, target)
                    KickState.Running = false
                    if ok and result then
                        local oldChar = myChar
                        repeat task.wait(0.06) until not KickState.Enabled or LP.Character ~= oldChar
                    end
                end
                task.wait(0.12)
            end

            return
        end

        local cars = Workspace:FindFirstChild('CarContainer')
        if not cars then
            Library:Notify('Kick: CarContainer missing', 2)
            stopKick()
            return
        end

        local blacklisted = {}
        for _, v in ipairs(cars:GetChildren()) do
            if v.Name == 'Squad' then blacklisted[v] = true end
        end

        local remotes = ReplicatedStorage:FindFirstChild('Remotes')
        local interact = remotes and remotes:FindFirstChild('InteractWithItem')
        local buttons = Workspace:FindFirstChild('Prison_ITEMS')
        buttons = buttons and buttons:FindFirstChild('buttons')
        if not interact or not buttons then
            Library:Notify('Kick: spawners missing', 2)
            stopKick()
            return
        end

        local children = buttons:GetChildren()
        local spawner4 = children[4] and children[4]:FindFirstChild('Car Spawner')
        local spawner5 = children[5] and children[5]:FindFirstChild('Car Spawner')
        if not spawner4 then
            Library:Notify('Kick: Car Spawner missing', 2)
            stopKick()
            return
        end

        local hp = getRoot()
        if not hp then stopKick() return end

        -- spawn the car. No tweening: jump to the spawner, fire the spawner,
        -- jump off again, all in the same pass.
        local spawned = false
        for _ = 1, 12 do
            if KickState.StopFlag then break end
            hp.CFrame = spawner4.CFrame
            pcall(function() interact:InvokeServer(spawner4) end)
            if spawner5 then pcall(function() interact:InvokeServer(spawner5) end) end
            task.wait(0.1)
            hp.CFrame = CFrame.new(589, 98, 2494)
            for _, v in ipairs(cars:GetChildren()) do
                if v.Name == 'Squad' and not blacklisted[v] then
                    spawned = true
                    break
                end
            end
            if spawned then break end
        end

        if not spawned or KickState.StopFlag then
            stopKick()
            return
        end

        local carModel
        for _, v in ipairs(cars:GetChildren()) do
            if v.Name == 'Squad' and not blacklisted[v] then
                carModel = v
                break
            end
        end
        if not carModel or handleMissingCar(cars) then stopKick() return end
        KickState.SpawnedCar = carModel

        local seat
        for _ = 1, 40 do
            local body = carModel:FindFirstChild('Body')
            seat = body and body:FindFirstChild('VehicleSeat')
            if not seat then
                for _, d in ipairs(carModel:GetDescendants()) do
                    if d:IsA('VehicleSeat') then seat = d break end
                end
            end
            if seat then break end
            task.wait(0.05)
        end
        if not seat then
            Library:Notify('Kick: no VehicleSeat', 2)
            stopKick()
            return
        end

        -- 1. nothing is armed yet. The car is parked on them first; the kick
        --    only fires from Touched or from the seat reporting them as its
        --    Occupant, so the kicker is never reset for a target who is just
        --    standing near the car.
        KickState.OwnedSeat   = seat
        KickState.OwnerSource = 'spawned'
        setMaxSimRadius()

        -- Server truth only. seat.Occupant is replicated from the server and is
        -- only set when the server has actually welded the target into this
        -- seat. Humanoid.SeatPart is client-local: it reads true for a seat that
        -- only exists on our screen, which is exactly the case that used to arm
        -- the kick and throw it back at us. It is deliberately not consulted.
        local function targetInSeat()
            local tChar = target and target.Character
            local tHum  = tChar and tChar:FindFirstChildOfClass('Humanoid')
            if not tHum then return false end
            return seat.Occupant == tHum
        end

        -- Weld the kicker into the same car, in a free passenger seat. This is
        -- the same sequence doCarKickOnce uses: get seated first, and only then
        -- die. The break of that weld is the desync that reaches the driver.
        local function seatKickerInCar()
            local myHum = getHum()
            local myRootNow = getRoot()
            if not (myHum and myRootNow) or myHum.Health <= 0 then return false end

            local passengerSeat = findPassengerSeat(carModel, seat)
            if not passengerSeat then return false end

            local t0 = os.clock()
            while KickState.Enabled
                and myHum.Health > 0
                and myHum.SeatPart ~= passengerSeat
                and os.clock() - t0 < 2
            do
                pcall(function()
                    myRootNow.CFrame = passengerSeat.CFrame * CFrame.new(0, 2, 0)
                    passengerSeat:Sit(myHum)
                end)
                task.wait()
            end

            return myHum.Health > 0 and myHum.SeatPart == passengerSeat
        end

        -- 2. the kick, armed by contact with the target or by them holding the
        --    driver seat. Both routes land here, and the server check is repeated
        --    here so neither can arm on client-side contact alone.
        local function triggerContact()
            if KickState.Contact or KickState.KickAnimStarted then return end
            if not targetInSeat() then return end

            KickState.KickAnimStarted = true
            KickState.Contact = true     -- stop the ram from moving the car
            KickState.KickDone = false

            task.spawn(function()
                -- get welded in next to them first; without a seat weld of our
                -- own there is no desync and the hit stays on us
                seatKickerInCar()

                if not KickState.Enabled or KickState.StopFlag then return end

                -- if they slipped out while we were climbing in, get out again
                -- and go back to parking instead of throwing at nothing
                if not targetInSeat() then
                    pcall(function()
                        local h = getHum()
                        if h then h.Sit = false end
                    end)
                    KickState.Contact = false
                    KickState.KickAnimStarted = false
                    KickState.KickDone = false
                    return
                end

                -- reset first, and do it synchronously. When resetKicker()
                -- returns the humanoid is already dead and its joints are gone,
                -- so nothing that runs after this can be mistaken for the
                -- kicker's live assembly.
                resetKicker()

                -- then throw. RESET_SETTLE gives the death time to land before
                -- the first frame of throw velocity is written; the Heartbeat
                -- holds the throw at fling == false until KickDone.
                task.delay(RESET_SETTLE, function()
                    KickState.KickDone = true
                end)
            end)
        end

        if KickState.FlingConn then KickState.FlingConn:Disconnect() end
        local announcedSeat = false
        KickState.FlingConn = RunService.Heartbeat:Connect(function()
            if not KickState.Enabled then return end
            if not target or target.Parent ~= Players then return end

            local seatNow = KickState.OwnedSeat
            if not (seatNow and seatNow.Parent) then return end

            if KickState.Contact then
                -- the seat already has them. Until the reset settles the
                -- assembly is only bound, never thrown; after that it goes.
                bindOwnedPartToTarget(seatNow, seatNow, target, KickState.KickDone)
            else
                if not ramTarget(seatNow, target) then return end

                if not KickState.RamStarted then
                    KickState.RamStarted = true
                    setMaxSimRadius()
                    if not announcedSeat then
                        announcedSeat = true
                        Library:Notify('Kick: parking the car on the target', 2)
                    end
                end

                bindOwnedPartToTarget(seatNow, seatNow, target, false)

                -- seat check: only the server saying the target is the Occupant
                -- arms the kick. Client-side parking of the seat is not enough.
                if targetInSeat() then
                    triggerContact()
                end
            end

            local spawnedCar = KickState.SpawnedCar
            if spawnedCar and spawnedCar.Parent and not handleMissingCar(cars) then
                for _, v in ipairs(spawnedCar:GetDescendants()) do
                    if v:IsA('BasePart') and v ~= seatNow then
                        bindOwnedPartToTarget(v, seatNow, target, KickState.Contact and KickState.KickDone)
                    end
                end
            end
        end)

        -- collision trigger: any part of the target's character touching the seat.
        -- Touched is client physics, so it only ever asks for the kick; the
        -- Occupant check inside triggerContact decides whether it is real.
        if KickState.ContactConn then
            KickState.ContactConn:Disconnect()
            KickState.ContactConn = nil
        end
        KickState.ContactConn = seat.Touched:Connect(function(hit)
            if KickState.Contact then return end
            if not target or target.Parent ~= Players then return end
            local char = target.Character
            if char and hit and hit:IsDescendantOf(char) then
                triggerContact()
            end
        end)
    end)

    return true, 'running'
end
    -- ===================== KILL =====================
    local function stopKill()
        KillState.Enabled = false
        KillState.TargetUserId = nil
        if KillState.Conn then
            KillState.Conn:Disconnect()
            KillState.Conn = nil
        end
        setNoclip(false)
        local root = getRoot()
        local hum = getHum()
        if root then pcall(function() root.Anchored = false end) end
        if hum then
            pcall(function()
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
        pcall(function() Workspace.CurrentCamera.CameraSubject = getHum() end)
        if KillState.Platform then
            pcall(function() KillState.Platform:Destroy() end)
            KillState.Platform = nil
        end
    end

    local function fireAtPart(tool, targetPart, originOverride)
        if not tool or not targetPart or not targetPart:IsA('BasePart') then return false end
        local char = LP.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass('Humanoid')
        if not hum or hum.Health <= 0 then return false end

        local origin = originOverride
        if not origin then
            local head = char:FindFirstChild('Head') or char:FindFirstChild('HumanoidRootPart')
            origin = head and head.Position or Vector3.zero
        end

        local targetPos = targetPart.Position
        local lower = string.lower(tool.Name)
        local isShotgun = string.find(lower, 'remington') or string.find(lower, '870') or string.find(lower, 'shotgun')
        local pellets = isShotgun and 8 or 1
        local shots = table.create(pellets)
        for i = 1, pellets do
            local aim = targetPos
            if isShotgun then
                aim = targetPos + Vector3.new(
                    (math.random() - 0.5) * 1.5,
                    (math.random() - 0.5) * 1.5,
                    (math.random() - 0.5) * 1.5
                )
            end
            shots[i] = { origin, aim, targetPart }
        end

        pcall(function() tool:Activate() end)
        local ok = pcall(function() ShootEvent:FireServer(shots) end)
        if ok then
            pcall(function()
                local cur = tool:GetAttribute('Local_CurrentAmmo') or tool:GetAttribute('CurrentAmmo')
                if typeof(cur) == 'number' then
                    tool:SetAttribute('Local_CurrentAmmo', math.max(0, cur - 1))
                end
            end)
        end
        return ok
    end

    local function startKill(plr)
        if not plr then return false end
        if KillState.Enabled and KillState.TargetUserId == plr.UserId then
            stopKill()
            return false
        end
        stopKill()

        KillState.Enabled = true
        KillState.TargetUserId = plr.UserId
        KillState.StartTime = tick()

        local OFFSET, ORBIT_SPEED, ATTACK_DELAY = 15, 10, 0.03
        local VOID_Y = (Options.VoidReloadDepth and Options.VoidReloadDepth.Value) or -250
        local UNDER_DIST, PHASE1_TIME, MAX_DURATION = 12, 2, 30

        local angle, lastAttack, reloading = 0, 0, false
        local startPos = getRoot() and getRoot().CFrame or nil
        local phase, phaseTimer, startHealth = 1, 0, nil
        local waitingForFF, viewing = false, false

        local saved360 = nil
        if Toggles.SilentAim360 then
            saved360 = Toggles.SilentAim360.Value
            pcall(function() Toggles.SilentAim360:SetValue(true) end)
        end

        setNoclip(true)
        equipBestGun()

        local function ensurePlatform(pos)
            if not KillState.Platform or not KillState.Platform.Parent then
                local p = Instance.new('Part')
                p.Name = 'KillPlatform'
                p.Size = Vector3.new(8, 1, 8)
                p.Anchored = true
                p.CanCollide = true
                p.CanQuery = false
                p.CanTouch = false
                p.Material = Enum.Material.SmoothPlastic
                p.Color = Color3.fromRGB(120, 0, 0)
                p.Transparency = 0.35
                p.Parent = Workspace
                KillState.Platform = p
            end
            KillState.Platform.CFrame = CFrame.new(pos)
        end

        local function lockToPlatform(myRoot, platformPos)
            local standPos = platformPos + Vector3.new(0, 3.1, 0)
            myRoot.CFrame = CFrame.new(standPos)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
            ensurePlatform(platformPos)
        end

        local function unlockCharacter()
            local root = getRoot()
            local hum = getHum()
            if root then pcall(function() root.Anchored = false end) end
            if hum then
                pcall(function()
                    hum.PlatformStand = false
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end)
            end
        end

        local function getHitPart(tChar)
            for _, name in ipairs({ 'Head', 'HumanoidRootPart', 'UpperTorso', 'LowerTorso' }) do
                local p = tChar:FindFirstChild(name)
                if p and p:IsA('BasePart') then return p end
            end
            return nil
        end

        local function resolveOrigin(myRoot, tChar, hitPart)
            local myHead = LP.Character and (LP.Character:FindFirstChild('Head') or myRoot)
            local origin = myHead and myHead.Position or myRoot.Position
            local targetPos = hitPart.Position
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { LP.Character, tChar }
            if not Workspace:Raycast(origin, targetPos - origin, params) then return origin end
            if not (Toggles.Wallbang and Toggles.Wallbang.Value) then return origin end
            local offsets = {
                Vector3.new(0, 4, 0), Vector3.new(3, 2, 0), Vector3.new(-3, 2, 0),
                Vector3.new(0, 2, 3), Vector3.new(0, 2, -3), Vector3.new(0, 6, 0),
            }
            for _, off in ipairs(offsets) do
                local testOrigin = origin + off
                if not Workspace:Raycast(testOrigin, targetPos - testOrigin, params) then
                    return testOrigin
                end
            end
            return origin
        end

        local function startViewing(target)
            local hum = target.Character and target.Character:FindFirstChildOfClass('Humanoid')
            if hum then
                Workspace.CurrentCamera.CameraSubject = hum
                viewing = true
            end
        end

        local function stopViewing()
            if viewing then
                pcall(function() Workspace.CurrentCamera.CameraSubject = getHum() end)
                viewing = false
            end
        end

        local function onTargetKilled()
            unlockCharacter()
            stopViewing()
            local root = getRoot()
            if root and startPos then
                root.CFrame = startPos
                root.AssemblyLinearVelocity = Vector3.zero
            end
            if KillState.Platform then
                pcall(function() KillState.Platform:Destroy() end)
                KillState.Platform = nil
            end
            KillState.Enabled = false
            KillState.TargetUserId = nil
            if saved360 ~= nil and Toggles.SilentAim360 then
                pcall(function() Toggles.SilentAim360:SetValue(saved360) end)
            end
        end

        KillState.Conn = RunService.Heartbeat:Connect(function(dt)
            if not KillState.Enabled then return end
            if tick() - KillState.StartTime > MAX_DURATION then stopKill() return end

            local target = Players:GetPlayerByUserId(KillState.TargetUserId)
            if not target then
                if saved360 ~= nil and Toggles.SilentAim360 then
                    pcall(function() Toggles.SilentAim360:SetValue(saved360) end)
                end
                stopKill()
                return
            end

            local tChar = target.Character
            local myRoot = getRoot()
            if not tChar then onTargetKilled() return end

            local tHum  = tChar:FindFirstChildOfClass('Humanoid')
            local tRoot = tChar:FindFirstChild('HumanoidRootPart')
            if not tHum or tHum.Health <= 0 or not tRoot then onTargetKilled() return end

            if tChar:FindFirstChildOfClass('ForceField') then
                waitingForFF = true
                unlockCharacter()
                stopViewing()
                return
            end

            if waitingForFF then
                waitingForFF = false
                phase, phaseTimer, startHealth = 1, 0, nil
                setNoclip(true)
                equipBestGun()
                startViewing(target)
            end

            if not viewing then startViewing(target) end
            if not myRoot then return end

            local tool = LP.Character and LP.Character:FindFirstChildOfClass('Tool')
            local needReload = false
            if tool then
                local ammo = tool:FindFirstChild('Ammo') or tool:FindFirstChild('ammo')
                if ammo and typeof(ammo.Value) == 'number' and ammo.Value <= 0 then needReload = true end
                local localAmmo = tool:GetAttribute('Local_CurrentAmmo') or tool:GetAttribute('CurrentAmmo')
                if typeof(localAmmo) == 'number' and localAmmo <= 0 then needReload = true end
            end
            if needReload and not reloading then
                reloading = true
                unlockCharacter()
                task.spawn(function()
                    local r = getRoot()
                    if not r then reloading = false return end
                    local savedCF = r.CFrame
                    r.CFrame = CFrame.new(r.Position.X, VOID_Y, r.Position.Z)
                    r.AssemblyLinearVelocity = Vector3.zero
                    pcall(function() if FuncReload then FuncReload:InvokeServer() end end)
                    task.wait(0.45)
                    r = getRoot()
                    if r then r.CFrame = savedCF r.AssemblyLinearVelocity = Vector3.zero end
                    reloading = false
                    equipBestGun()
                end)
                return
            end

            if phase == 1 and startHealth == nil then startHealth = tHum.Health end
            phaseTimer = phaseTimer + dt
            if phase == 1 and phaseTimer >= PHASE1_TIME then
                if startHealth and tHum.Health >= startHealth - 0.5 then
                    phase = 2
                    unlockCharacter()
                    if KillState.Platform then
                        pcall(function() KillState.Platform:Destroy() end)
                        KillState.Platform = nil
                    end
                else
                    phaseTimer = 0
                    startHealth = tHum.Health
                end
            end

            if phase == 1 then
                local underPos = tRoot.Position - Vector3.new(0, UNDER_DIST, 0)
                lockToPlatform(myRoot, underPos - Vector3.new(0, 3.1, 0))
            else
                unlockCharacter()
                angle = angle + ORBIT_SPEED * dt
                local jitter = math.random() * math.pi * 2
                local height = math.random() * 3
                myRoot.CFrame = tRoot.CFrame * CFrame.new(
                    math.cos(angle + jitter) * OFFSET, height, math.sin(angle + jitter) * OFFSET
                )
                myRoot.AssemblyLinearVelocity = Vector3.zero
            end

            if tick() - lastAttack < ATTACK_DELAY then return end
            lastAttack = tick()
            equipBestGun()
            tool = LP.Character and LP.Character:FindFirstChildOfClass('Tool')
            if not tool then return end
            local hitPart = getHitPart(tChar)
            if not hitPart then return end
            fireAtPart(tool, hitPart, resolveOrigin(myRoot, tChar, hitPart))
            local melee = ReplicatedStorage:FindFirstChild('meleeEvent')
            if melee and melee:IsA('RemoteEvent') then
                pcall(function() melee:FireServer(target, 1, 1) end)
            end
        end)

        return true
    end

