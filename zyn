-- ====================== WHITELIST SYSTEM (SA + RAGE) ======================
-- Each whitelist is a plain table on getgenv, keyed by BOTH:
--   "id:<UserId>"  -> stable across display-name changes
--   "<DisplayName>" and "<Name>" -> convenience lookups
-- All three keys point to the same true value, so a hit on any one
-- protects the player.

getgenv().SAWhitelist = getgenv().SAWhitelist or {}
getgenv().RageWhitelist = getgenv().RageWhitelist or {}

local function wlAdd(list, plr)
    if not plr then return end
    list['id:' .. tostring(plr.UserId)] = true
    list[plr.Name] = true
    if plr.DisplayName and plr.DisplayName ~= plr.Name then
        list[plr.DisplayName] = true
    end
end

local function wlRemove(list, plr)
    if not plr then return end
    list['id:' .. tostring(plr.UserId)] = nil
    list[plr.Name] = nil
    if plr.DisplayName then list[plr.DisplayName] = nil end
end

local function wlHas(list, plr)
    if not list or not plr then return false end
    if list['id:' .. tostring(plr.UserId)] then return true end
    if list[plr.Name] then return true end
    if plr.DisplayName and list[plr.DisplayName] then return true end
    return false
end

local function wlToString(list)
    -- Only show unique names (dedupe the id: keys and duplicate name keys)
    local seen, out = {}, {}
    for k, v in pairs(list) do
        if v and not string.find(k, '^id:') then
            if not seen[k] then
                seen[k] = true
                table.insert(out, k)
            end
        end
    end
    table.sort(out)
    return (#out > 0) and table.concat(out, ', ') or 'None'
end

local function wlPlayerNames(excludeLP)
    local names = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if not (excludeLP and plr == LP) then
            table.insert(names, plr.DisplayName or plr.Name)
        end
    end
    table.sort(names)
    return names
end

local function wlRefreshDropdown(dropdown)
    if not dropdown then return end
    local names = wlPlayerNames(true)
    if #names == 0 then names = { 'None' } end
    pcall(function()
        dropdown.Values = names
        if dropdown.SetValues then dropdown:SetValues(names) end
    end)
end

