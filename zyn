-- ========== CHARACTER HOOKS ==========
local function hook(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	hum.Died:Connect(function()
		if not autoOnDeath then return end
		deathToken += 1
		local token = deathToken
		lastDeathClock = os.clock()
		task.delay(0.35, function()
			if token == deathToken then runTeamSwitch(token) end
		end)
	end)
	clearFfConns()
	hookForceField(char)
end

if player.Character then hook(player.Character) end
player.CharacterAdded:Connect(function(char)
	hook(char)
	if underFloorOn then stopUnder(false) end
end)

