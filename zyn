-- ===================== EQUIP ALL + PP (GRIP OFFSET) =====================
local MiscWeaponsBox = Tabs.Misc:AddLeftGroupbox('Weapons')

local DefaultGrip = Vector3.new(1, 2, 0)
local LongerGrip  = Vector3.new(1, 2, 1.5)
local ToolGrips = {
    ['Remington 870'] = LongerGrip,
    ['AK-47']         = LongerGrip,
    ['M4A1']          = LongerGrip,
    ['FAL']           = LongerGrip,
    ['MP5']           = DefaultGrip,
    ['M9']            = DefaultGrip,
    ['Taser']         = DefaultGrip,
    ['M700']          = DefaultGrip,
    ['Revolver']      = DefaultGrip,
    ['Hammer']        = DefaultGrip,
}

-- Halved lengths: Roblox measures GripPos from the handle (center of gun).
-- The -0.15 in the loop below ensures they barely touch without gaps.
local GunLengths = {
    ['M700']          = 4.0,  -- Sniper
    ['Remington 870'] = 3.5,  -- Shotgun
    ['AK-47']         = 3.0,
    ['FAL']           = 3.0,
    ['M4A1']          = 2.75,
    ['MP5']           = 2.25,
    ['Revolver']      = 1.75,
    ['M9']            = 1.5,
    ['Taser']         = 1.0,
    ['Hammer']        = 1.0,
}

local originalGrips = setmetatable({}, { __mode = 'k' })

local function applyGrip(tool)
    if not tool or not tool:IsA('Tool') then return end
    local grip = ToolGrips[tool.Name]
    if not grip then return end
    if tool.GripPos == grip then return end
    if originalGrips[tool] == nil then
        originalGrips[tool] = tool.GripPos
    end
    tool.GripPos = grip
end

local function restoreGrips()
    for tool, grip in pairs(originalGrips) do
        if tool and tool.Parent then
            pcall(function() tool.GripPos = grip end)
        end
    end
    table.clear(originalGrips)
end

local EQUIP_ALL_NAMES = {
    ['M4A1']          = true,
    ['M9']            = true,
    ['Remington 870'] = true,
    ['FAL']           = true,
    ['Revolver']      = true,
    ['MP5']           = true,
    ['M700']          = true,
    ['AK-47']         = true,
    ['Hammer']        = true,
}

local function isEquipAllGun(tool)
    if not tool or not tool:IsA('Tool') then return false end
    if EQUIP_ALL_NAMES[tool.Name] then return true end
    local lower = string.lower(tool.Name)
    for name in pairs(EQUIP_ALL_NAMES) do
        if string.find(lower, string.lower(name), 1, true) then return true end
    end
    return false
end

local function collectEquipAllGuns()
    local list = {}
    local seen = {}
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass('Backpack') or LP:FindFirstChild('Backpack')
    local function add(t)
        if t and t:IsA('Tool') and isEquipAllGun(t) and not seen[t] then
            seen[t] = true
            table.insert(list, t)
        end
    end
    if char then
        for _, c in ipairs(char:GetChildren()) do add(c) end
    end
    if bp then
        for _, c in ipairs(bp:GetChildren()) do add(c) end
    end
    return list
end

local function resetEquipAll()
    local char = LP.Character
    local bp = LP:FindFirstChildOfClass('Backpack') or LP:FindFirstChild('Backpack')
    if not char or not bp then return end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA('Tool') then
            pcall(function() c.Parent = bp end)
        end
    end
end

local equipAllRunning = false

local function runEquipAll(lineUpMode)
    if equipAllRunning then return end
    equipAllRunning = true

    local hum = LP.Character and LP.Character:FindFirstChildOfClass('Humanoid')
    local char = LP.Character
    if not hum or not char then
        equipAllRunning = false
        return
    end

    local guns = collectEquipAllGuns()
    if #guns == 0 then
        Library:Notify('Equip All: no matching guns in inventory', 2)
        equipAllRunning = false
        return
    end

    -- Sort Longest to Shortest
    table.sort(guns, function(a, b)
        local lenA = GunLengths[a.Name] or 2.5
        local lenB = GunLengths[b.Name] or 2.5
        return lenA > lenB
    end)

    if lineUpMode then
        -- Shortest gun is equipped first (at the very front)
        local shortestGun = guns[#guns]
        if shortestGun and shortestGun.Parent then
            pcall(function() hum:EquipTool(shortestGun) end)
            task.wait(0.05)
        end

        -- Parent the rest backwards, touching each other
        local currentZ = 0
        for i = #guns - 1, 1, -1 do
            local gun = guns[i]
            if gun and gun.Parent and gun.Parent ~= char then
                local baseGrip = ToolGrips[gun.Name] or DefaultGrip
                
                -- Push back by half-length, minus 0.15 studs so they barely touch
                currentZ = currentZ + (GunLengths[gun.Name] or 2.5) - 0.15
                
                gun.GripPos = Vector3.new(baseGrip.X, baseGrip.Y, baseGrip.Z + currentZ)
                pcall(function() gun.Parent = char end)
                task.wait(0.02)
            end
        end
    else
        -- Standard Equip All (stacked together)
        local firstGun = guns[1]
        if firstGun and firstGun.Parent then
            pcall(function() hum:EquipTool(firstGun) end)
            task.wait(0.05)
        end

        for i = 2, #guns do
            local gun = guns[i]
            if gun and gun.Parent and gun.Parent ~= char then
                applyGrip(gun)
                pcall(function() gun.Parent = char end)
                task.wait(0.02)
            end
        end
    end

    Library:Notify('Equip All: ' .. #guns .. ' guns equipped', 2)
    equipAllRunning = false
end

