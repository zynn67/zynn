        local selected = opt and opt.Value
        local want = {}
        if typeof(selected) ~= 'table' then return want end
        if selected[1] ~= nil then
            for _, n in ipairs(selected) do want[n] = true end
        else
            for n, on in pairs(selected) do if on then want[n] = true end end
        end
        return want
    end

    local function getWantedNames()
        if teamName() == 'Criminals' then
            return parseDropdown(Options.GetWeaponListCrim)
        end
        return parseDropdown(Options.GetWeaponListGuard)
    end

    local function hasGun(backpackId)
        local function scan(bag)
            if not bag then return false end
            for _, c in ipairs(bag:GetChildren()) do
                if string.find(string.lower(c.Name), string.lower(backpackId), 1, true) then
                    return true
                end
            end
            return false
        end
        return scan(LP.Character) or scan(LP:FindFirstChild('Backpack'))
    end

    -- Parallax-style: find the giver at this gun's pivot only
    local function getGiverModel(gun)
        local best, bestDist = nil, 8
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA('Model') or obj:IsA('BasePart') then
                local pos
                if obj:IsA('BasePart') then
                    pos = obj.Position
                elseif obj.PrimaryPart then
                    pos = obj.PrimaryPart.Position
                else
                    local p = obj:FindFirstChildWhichIsA('BasePart')
                    pos = p and p.Position
                end
                if pos then
                    local d = (pos - gun.pivot).Magnitude
                    if d < bestDist then
                        bestDist = d
                        best = obj
                    end
                end
            end
        end
        -- also Prison_ITEMS.giver children
        pcall(function()
            local pi = Workspace:FindFirstChild('Prison_ITEMS')
            local giverFolder = pi and (pi:FindFirstChild('giver') or pi)
            if not giverFolder then return end
            for _, obj in ipairs(giverFolder:GetChildren()) do
                local p = obj:IsA('BasePart') and obj or obj:FindFirstChildWhichIsA('BasePart')
                if p and (p.Position - gun.pivot).Magnitude < bestDist then
                    bestDist = (p.Position - gun.pivot).Magnitude
                    best = obj
                end
            end
        end)
        return best
    end

    local function getTouchPart(giver)
        if not giver then return nil end
        if giver:IsA('BasePart') then return giver end
        for _, n in ipairs({ 'TouchGiver', 'Giver', 'Handle', 'ITEMPICKUP' }) do
            local t = giver:FindFirstChild(n)
            if t and t:IsA('BasePart') then return t end
        end
        if giver.PrimaryPart then return giver.PrimaryPart end
        return giver:FindFirstChildWhichIsA('BasePart')
    end

    -- ONLY Parallax remotes
    local function parallaxPickup(gun)
        local giver = getGiverModel(gun)
        if not giver then return end
        local touch = getTouchPart(giver)

        pcall(function()
            local remotes = ReplicatedStorage:FindFirstChild('Remotes')
            if not remotes then return end
            local gp = remotes:FindFirstChild('GiverPressed')
            local iwi = remotes:FindFirstChild('InteractWithItem')
            if gp then gp:FireServer(giver) end
            if iwi and touch then iwi:InvokeServer(touch) end
        end)
    end

    local function entriesForTeam()
        local want = getWantedNames()
        local t = teamName()
        local list = {}
        for _, g in ipairs(GUNS) do
            local teamOk = false
            for _, tn in ipairs(g.teams) do
                if tn == t then teamOk = true break end
            end
            if not teamOk and t == '' then
                for _, tn in ipairs(g.teams) do
                    if tn == 'Guards' or tn == 'Inmates' then teamOk = true break end
                end
            end
            if not teamOk then continue end
            if g.name == 'Remington 870 Crim' then
                if want['Remington 870'] then table.insert(list, g) end
            elseif want[g.name] then
                table.insert(list, g)
            end
        end
        return list
    end

    local function runGetGuns()
        if busy then return end
        busy = true

        local root = getRoot()
        if not root then busy = false return end

        local list = entriesForTeam()
        if #list == 0 then
            if Library then Library:Notify('No guns selected for your team', 2) end
            busy = false
            if Toggles.GetWeaponsNow then pcall(function() Toggles.GetWeaponsNow:SetValue(false) end) end
            return
        end

        local savedCF = root.CFrame
        local cam = Workspace.CurrentCamera
        local savedCamCF = cam and cam.CFrame
        local savedCamType = cam and cam.CameraType
        local holdCam
        if cam then
            cam.CameraType = Enum.CameraType.Scriptable
            cam.CFrame = savedCamCF
            holdCam = RunService.RenderStepped:Connect(function()
                if cam and savedCamCF then cam.CFrame = savedCamCF end
            end)
        end

        for _, gun in ipairs(list) do
            root = getRoot()
            if not root then break end
            if hasGun(gun.backpackId) then continue end

            -- Parallax: TP under → remote → next
            root.CFrame = gun.teleport
            root.AssemblyLinearVelocity = Vector3.zero
            parallaxPickup(gun)
            task.wait(0.04)
            parallaxPickup(gun)

            if not hasGun(gun.backpackId) then
                task.wait(0.04)
                root = getRoot()
                if root then
                    root.CFrame = gun.teleport
                    parallaxPickup(gun)
                end
            end
        end

        root = getRoot()
        if root then
            root.CFrame = savedCF
            root.AssemblyLinearVelocity = Vector3.zero
        end

        if holdCam then holdCam:Disconnect() end
        if cam then
            cam.CameraType = savedCamType or Enum.CameraType.Custom
            if savedCamCF then cam.CFrame = savedCamCF end
        end

                busy = false

        -- prevent OnChanged re-entry when turning the toggle off
        suppressToggle = true
        if Toggles.GetWeaponsNow and Toggles.GetWeaponsNow.Value then
            pcall(function() Toggles.GetWeaponsNow:SetValue(false) end)
        end
        task.defer(function()
            suppressToggle = false
        end)

        if Library then Library:Notify('Get Guns done', 2) end
    end

    if Toggles.GetWeaponsNow then
        Toggles.GetWeaponsNow:OnChanged(function()
            if suppressToggle then return end
            if not Toggles.GetWeaponsNow.Value then return end
            if busy then return end
            task.spawn(runGetGuns)
        end)
    end

    LP.CharacterAdded:Connect(function()
        if not (Toggles.AutoGetOnSpawn and Toggles.AutoGetOnSpawn.Value) then return end
        task.wait(0.8)
        if busy then return end
        task.spawn(runGetGuns)
    end)
end


