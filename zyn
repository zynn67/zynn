        Default = 'RightControl',
        SyncToggleState = false,
        Modes = { 'Toggle', 'Hold', 'Always' },
        Text = 'PGui'
    })

    Toggles.ShowPGui:OnChanged(function()
        if Toggles.ShowPGui.Value then
            buildPGui()
        else
            destroyPGui()
            stopPunchLK()
            stopView()
            stopKill()
            stopKick()
        end
    end)

    Players.PlayerRemoving:Connect(function(plr)
        if PunchLK.TargetUserId == plr.UserId then stopPunchLK() end
        if ViewState.TargetUserId == plr.UserId then stopView() end
        if KillState.TargetUserId == plr.UserId then stopKill() end
        if expandedUserId == plr.UserId then expandedUserId = nil end
        task.defer(rebuildPlayerList)
    end)
    Players.PlayerAdded:Connect(function()
        task.defer(rebuildPlayerList)
    end)
