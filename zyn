-- ========== UNDER / ABOVE / RETURN ==========
local underFloorOn, underConn, savedY, holdY, platform = false, nil, nil, nil, nil
local aboveOn = false
local PLATFORM_SIZE, FOOT_GAP = Vector3.new(24, 1.5, 24), 3.05

local function rayParams()
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	if player.Character then table.insert(ex, player.Character) end
	if platform and platform.Parent then table.insert(ex, platform) end
	rp.FilterDescendantsInstances = ex
	return rp
end

local function saveY()
	local root = getRoot()
	if not root then return false end
	savedY = root.Position.Y
	return true
end

local function restoreYOnly()
	local root = getRoot()
	if not root or savedY == nil then return false end
	local p = root.Position
	root.CFrame = CFrame.new(p.X, savedY, p.Z) * (root.CFrame - root.CFrame.Position)
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function destroyPlatform()
	if platform then pcall(function() platform:Destroy() end) platform = nil end
	for _, v in ipairs(Workspace:GetChildren()) do
		if v.Name == "UnderPlatform" or v.Name == "AbovePlatform" then
			pcall(function() v:Destroy() end)
		end
	end
end

local function stopAllFloor()
	underFloorOn = false
	aboveOn = false
	if underConn then underConn:Disconnect() underConn = nil end
	destroyPlatform()
	holdY = nil
end

local function ensurePlatform(rootPos)
	if not holdY then return end
	local py = holdY - FOOT_GAP
	if not platform or not platform.Parent then
		local p = Instance.new("Part")
		p.Name = "UnderPlatform"
		p.Anchored = true
		p.CanCollide = true
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(255, 140, 0)
		p.Transparency = 0.3
		p.Size = PLATFORM_SIZE
		p.CFrame = CFrame.new(rootPos.X, py, rootPos.Z)
		p.Parent = Workspace
		platform = p
	else
		platform.CFrame = CFrame.new(rootPos.X, py, rootPos.Z)
	end
end

local function startHold(y, isAbove)
	stopAllFloor()
	holdY = y
	underFloorOn = not isAbove
	aboveOn = isAbove
	local root = getRoot()
	if root then ensurePlatform(root.Position) end
	underConn = RunService.Heartbeat:Connect(function()
		if not holdY then return end
		local r = getRoot()
		if not r then return end
		r.CFrame = CFrame.new(r.Position.X, holdY, r.Position.Z) * (r.CFrame - r.CFrame.Position)
		local v = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
		ensurePlatform(r.Position)
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
	end)
end

local function toggleUnderFloor()
	if underFloorOn then
		stopAllFloor()
		restoreYOnly()
		notify("Under Floor OFF")
		return
	end
	local root = getRoot()
	if not root or not saveY() then notify("Under Floor failed") return end
	local hit = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -80, 0), rayParams())
	local y = hit and (hit.Position.Y - underOffset) or (root.Position.Y - underOffset)
	root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z)
	root.AssemblyLinearVelocity = Vector3.zero
	for _ = 1, 5 do
		holdY = y
		ensurePlatform(root.Position)
		if platform then break end
		task.wait()
	end
	startHold(y, false)
	notify("Under Floor ON (" .. underOffset .. " studs)")
end

local function floorAbove()
	local root = getRoot()
	if not root or not saveY() then notify("Above failed") return end
	local hit = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, 100, 0), rayParams())
	local y = (not hit) and (root.Position.Y + aboveOffset) or (hit.Position.Y + aboveOffset)
	if hit and hit.Position.Y <= root.Position.Y + 0.5 then notify("No higher surface") return end
	root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z)
	root.AssemblyLinearVelocity = Vector3.zero
	startHold(y, true)
	notify("Floor Above (" .. aboveOffset .. " studs)")
end

local function returnPos()
	stopAllFloor()
	restoreYOnly()
	notify("Returned")
end

