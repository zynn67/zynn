-- ========== FLING (CFrame based) ==========
local flingOn, flingConn, flingTarget = false, nil, nil

local function hasNetOwner(part)
	if typeof(isnetworkowner) == "function" then
		local ok, r = pcall(isnetworkowner, part)
		return ok and r == true
	end
	local ok, owner = pcall(function() return part:GetNetworkOwner() end)
	return ok and owner == player
end

local function getPlrRoot(plr)
	local c = plr and plr.Character
	if not c then return end
	local h = c:FindFirstChildOfClass("Humanoid")
	local r = c:FindFirstChild("HumanoidRootPart")
	if r and h and h.Health > 0 then return r end
end

local function applySeat(seat, targetRoot)
	-- Pure CFrame fling (no AssemblyLinearVelocity)
	local offset = CFrame.new(
		math.random(-2, 2),
		math.random(0, 2),
		math.random(-2, 2)
	)
	seat.CFrame = CFrame.new(targetRoot.Position) * offset

	pcall(function()
		sethiddenproperty(seat, "PhysicsRepRootPart", targetRoot)
	end)
	pcall(function()
		if InstanceHandle then
			sethiddenproperty(seat, "PhysicsRepRootRef", InstanceHandle.new(targetRoot))
		end
	end)

	local model = seat.Parent and seat.Parent.Parent
	if model then
		local w = model:FindFirstChild("Wheels")
		if w then pcall(function() w:Destroy() end) end
	end
end

local function stopFlingLoop()
	flingOn = false
	flingActive = false
	if flingConn then
		flingConn:Disconnect()
		flingConn = nil
	end
end

local function startFlingLoop()
	flingTarget = selectedFlingTarget
	if not flingTarget or not flingTarget.Parent then
		notify("Select a player first")
		return false
	end
	if flingOn then
		stopFlingLoop()
		notify("Fling OFF")
		return false
	end
	stopFlingLoop()
	flingOn = true
	flingActive = true
	flingConn = RunService.Heartbeat:Connect(function()
		if not flingOn or not flingTarget then return end
		local tRoot = getPlrRoot(flingTarget)
		if not tRoot then return end
		local container = Workspace:FindFirstChild("CarContainer")
		if not container then return end
		for _, seat in ipairs(container:GetDescendants()) do
			if seat:IsA("VehicleSeat") and hasNetOwner(seat) then
				applySeat(seat, tRoot)
			end
		end
	end)
	notify("Fling ON → " .. flingTarget.DisplayName)
	return true
end

-- ========== ANTI-FLING ==========
local antiConn, antiProps = nil, {}

local function startAntiFling()
	if antiConn then return end
	AntiFling = true
	antiConn = RunService.Heartbeat:Connect(function()
		local container = Workspace:FindFirstChild("CarContainer")
		if not container then return end
		for _, part in ipairs(container:GetDescendants()) do
			if part:IsA("BasePart") then
				if not antiProps[part] then
					antiProps[part] = { CanCollide = part.CanCollide, CanTouch = part.CanTouch }
				end
				part.CanCollide = false
				part.CanTouch = false
			end
		end
	end)
end

local function stopAntiFling()
	AntiFling = false
	if antiConn then antiConn:Disconnect() antiConn = nil end
	for part, props in pairs(antiProps) do
		if part and part.Parent then
			part.CanCollide = props.CanCollide
			part.CanTouch = props.CanTouch
		end
	end
	table.clear(antiProps)
end

-- ========== FORCEFIELD ==========
local ffConns = {}

local function clearFf()
	for _, c in ipairs(ffConns) do pcall(function() c:Disconnect() end) end
	table.clear(ffConns)
end

local function hookFF(char)
	clearFf()
	local function onGone()
		if FFReset then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then hum.Health = 0 end
		end
	end
	local existing = char:FindFirstChildOfClass("ForceField")
	if existing then table.insert(ffConns, existing.Destroying:Connect(onGone)) end
	table.insert(ffConns, char.ChildAdded:Connect(function(c)
		if c:IsA("ForceField") then table.insert(ffConns, c.Destroying:Connect(onGone)) end
	end))
end

