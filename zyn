-- ========== CONFIG ==========
local preferred = "inmate"
local autoOnDeath = true
local ffReset = false
local binds = { under = "None", above = "None", ret = "None" }

-- ========== TEAM LOGIC ==========
local teamBusy, deathToken, lastDeathClock = false, 0, 0
local DEATH_WINDOW = 8

local function getRTC()
	local r = ReplicatedStorage:FindFirstChild("Remotes")
	if r and r:FindFirstChild("RequestTeamChange") then return r.RequestTeamChange end
	for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
		if d.Name == "RequestTeamChange" and (d:IsA("RemoteFunction") or d:IsA("RemoteEvent")) then return d end
	end
end

local function requestTeam(team)
	local remote = getRTC()
	if not remote or not team then return end
	pcall(function()
		if remote:IsA("RemoteFunction") then remote:InvokeServer(team, 1) else remote:FireServer(team, 1) end
	end)
end

local function goNeutral()
	local t = Teams:FindFirstChild("Neutral")
	if t then requestTeam(t) end
end

local function goPreferred()
	if preferred == "guard" then
		local t = Teams:FindFirstChild("Guards")
		if t then requestTeam(t) end
	else
		local t = Teams:FindFirstChild("Inmates")
		if t then requestTeam(t) end
	end
end

local function onPreferred()
	local n = player.Team and player.Team.Name:lower() or ""
	if preferred == "guard" then return n:find("guard") or n:find("police") end
	return n:find("inmate") or n:find("prisoner")
end

local function isNeutral()
	local n = player.Team and player.Team.Name:lower() or ""
	return n:find("neutral") ~= nil
end

local function guardsFull()
	local g = Teams:FindFirstChild("Guards")
	return g and #g:GetPlayers() > 7
end

local function runTeamSwitch(token)
	if teamBusy or not autoOnDeath or token ~= deathToken then return end
	if os.clock() - lastDeathClock > DEATH_WINDOW then return end
	teamBusy = true
	task.spawn(function()
		if not getRTC() then
			window:Notify({ title = "Zyn", content = "RequestTeamChange not found" })
			teamBusy = false
			return
		end
		for _ = 1, 6 do
			if token ~= deathToken then break end
			goNeutral()
			task.wait(0.15)
			if isNeutral() then break end
		end
		task.wait(0.25)
		local tries = 0
		while tries < 40 do
			if token ~= deathToken or not autoOnDeath then break end
			if os.clock() - lastDeathClock > DEATH_WINDOW then break end
			if onPreferred() then break end
			tries += 1
			if preferred == "guard" and guardsFull() then task.wait(1) else goPreferred() task.wait(0.25) end
		end
		window:Notify({ title = "Zyn", content = onPreferred() and ("Joined " .. preferred) or "Team switch failed" })
		teamBusy = false
	end)
end

-- ========== UNDER FLOOR / ABOVE / RETURN ==========
local underFloorOn, underConn, savedY, holdY, platform = false, nil, nil, nil, nil
local underOffset = 7
local aboveOffset = 7
local PLATFORM_SIZE, FOOT_GAP = Vector3.new(24, 1.5, 24), 3.05

local function getRoot()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function rayParams()
	local rp = RaycastParams.new()
	rp.FilterType = Enum.RaycastFilterType.Exclude
	local ex = {}
	if player.Character then table.insert(ex, player.Character) end
	if platform and platform.Parent then table.insert(ex, platform) end
	rp.FilterDescendantsInstances = ex
	return rp
end

local function saveY()
	local root = getRoot()
	if not root then return false end
	savedY = root.Position.Y
	return true
end

local function restoreYOnly()
	local root = getRoot()
	if not root or savedY == nil then return false end
	local p = root.Position
	root.CFrame = CFrame.new(p.X, savedY, p.Z) * (root.CFrame - root.CFrame.Position)
	root.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function destroyPlatform()
	if platform then pcall(function() platform:Destroy() end) platform = nil end
	for _, v in ipairs(Workspace:GetChildren()) do
		if v.Name == "ZynUnderPlatform" then pcall(function() v:Destroy() end) end
	end
end

local function ensurePlatform(rootPos)
	if not holdY then return end
	local py = holdY - FOOT_GAP
	if not platform or not platform.Parent then
		local p = Instance.new("Part")
		p.Name = "ZynUnderPlatform"
		p.Anchored = true
		p.CanCollide = true
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(60, 60, 70)
		p.Transparency = 0.3
		p.Size = PLATFORM_SIZE
		p.CFrame = CFrame.new(rootPos.X, py, rootPos.Z)
		p.Parent = Workspace
		platform = p
	else
		platform.CFrame = CFrame.new(rootPos.X, py, rootPos.Z)
	end
end

local function stopUnder(doRestoreY)
	underFloorOn = false
	if underConn then underConn:Disconnect() underConn = nil end
	destroyPlatform()
	if doRestoreY then restoreYOnly() end
	holdY = nil
end

local function startUnder(y)
	stopUnder(false)
	holdY = y
	underFloorOn = true
	local root = getRoot()
	if root then ensurePlatform(root.Position) end
	underConn = RunService.Heartbeat:Connect(function()
		if not underFloorOn then return end
		local r = getRoot()
		if not r then return end
		r.CFrame = CFrame.new(r.Position.X, holdY, r.Position.Z) * (r.CFrame - r.CFrame.Position)
		local v = r.AssemblyLinearVelocity
		r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
		ensurePlatform(r.Position)
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Running) end
	end)
end

local function toggleUnderFloor()
	if underFloorOn then
		stopUnder(true)
		window:Notify({ title = "Zyn", content = "Under Floor OFF" })
		return
	end
	local root = getRoot()
	if not root or not saveY() then
		window:Notify({ title = "Zyn", content = "Under Floor failed" })
		return
	end
	local hit = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, -80, 0), rayParams())
	local y = hit and (hit.Position.Y - underOffset) or (root.Position.Y - underOffset)
	root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z)
	root.AssemblyLinearVelocity = Vector3.zero
	holdY = y
	for _ = 1, 5 do ensurePlatform(root.Position) if platform then break end task.wait() end
	startUnder(y)
	window:Notify({ title = "Zyn", content = "Under Floor ON (" .. underOffset .. " studs)" })
end

local function floorAbove()
	if underFloorOn then stopUnder(false) end
	local root = getRoot()
	if not root or not saveY() then
		window:Notify({ title = "Zyn", content = "Above failed" })
		return
	end
	local hit = Workspace:Raycast(root.Position + Vector3.new(0, 2, 0), Vector3.new(0, 100, 0), rayParams())
	local y = (not hit) and (root.Position.Y + aboveOffset) or (hit.Position.Y + aboveOffset)
	if hit and hit.Position.Y <= root.Position.Y + 0.5 then
		window:Notify({ title = "Zyn", content = "No higher surface" })
		return
	end
	root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z)
	root.AssemblyLinearVelocity = Vector3.zero
	window:Notify({ title = "Zyn", content = "Floor Above (" .. aboveOffset .. " studs)" })
end

local function returnPos()
	if underFloorOn then stopUnder(true) else restoreYOnly() destroyPlatform() end
	window:Notify({ title = "Zyn", content = "Returned" })
end

-- ========== FORCEFIELD ==========
local ffConns = {}
local function clearFfConns()
	for _, c in ipairs(ffConns) do pcall(function() c:Disconnect() end) end
	table.clear(ffConns)
end

local function doResetFromFF()
	if not ffReset then return end
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then hum.Health = 0 end
end

local function watchForceField(ff, char)
	if not ff or not ff:IsA("ForceField") then return end
	table.insert(ffConns, ff.Destroying:Connect(function() task.defer(doResetFromFF) end))
	table.insert(ffConns, ff.AncestryChanged:Connect(function()
		if not ff:IsDescendantOf(char) then task.defer(doResetFromFF) end
	end))
end

local function hookForceField(char)
	local existing = char:FindFirstChildOfClass("ForceField")
	if existing then watchForceField(existing, char) end
	table.insert(ffConns, char.ChildAdded:Connect(function(child)
		if child:IsA("ForceField") then watchForceField(child, char) end
	end))
	table.insert(ffConns, char.ChildRemoved:Connect(function(child)
		if child:IsA("ForceField") then task.defer(doResetFromFF) end
	end))
end

-- ========== FLING ==========
local flingOn, flingConn, flingTarget = false, nil, nil

local function hasNetOwner(part)
	if typeof(isnetworkowner) == "function" then
		local ok, r = pcall(isnetworkowner, part)
		return ok and r == true
	end
	local ok, owner = pcall(function() return part:GetNetworkOwner() end)
	return ok and owner == player
end

local function getPlrRoot(plr)
	local c = plr and plr.Character
	if not c then return end
	local h, r = c:FindFirstChildOfClass("Humanoid"), c:FindFirstChild("HumanoidRootPart")
	if r and h and h.Health > 0 then return r end
end

local function applySeat(seat, targetRoot)
	seat.AssemblyLinearVelocity = Vector3.new(10000, 10000, 0)
	seat.CFrame = CFrame.new(targetRoot.Position) * CFrame.new(-2, 0, -12)
	pcall(function() sethiddenproperty(seat, "PhysicsRepRootPart", targetRoot) end)
	pcall(function()
		if InstanceHandle then sethiddenproperty(seat, "PhysicsRepRootRef", InstanceHandle.new(targetRoot)) end
	end)
	local model = seat.Parent and seat.Parent.Parent
	if model then
		local w = model:FindFirstChild("Wheels")
		if w then pcall(function() w:Destroy() end) end
	end
end

local function stopFling()
	flingOn = false
	if flingConn then flingConn:Disconnect() flingConn = nil end
end

local function startFling()
	if not flingTarget or not flingTarget.Parent then
		if window then
			window:Notify({ title = "Zyn", content = "Select a player first" })
		end
		return false
	end
	stopFling()
	flingOn = true
	flingConn = RunService.Heartbeat:Connect(function()
		if not flingOn or not flingTarget then return end
		local tRoot = getPlrRoot(flingTarget)
		if not tRoot then return end
		local container = Workspace:FindFirstChild("CarContainer")
		if not container then return end
		for _, seat in ipairs(container:GetDescendants()) do
			if seat:IsA("VehicleSeat") and hasNetOwner(seat) then
				applySeat(seat, tRoot)
			end
		end
	end)
	if window then
		window:Notify({ title = "Zyn", content = "Fling ON → " .. flingTarget.Name })
	end
	return true
end

