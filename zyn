local function snapshot()
	return {
		preferred = preferred,
		autoOnDeath = autoOnDeath,
		ffReset = ffReset,
		binds = { under = binds.under, above = binds.above, ret = binds.ret },
	}
end

local function applySnapshot(data)
	if type(data) ~= "table" then return end
	if data.preferred == "guard" or data.preferred == "inmate" then preferred = data.preferred end
	if type(data.autoOnDeath) == "boolean" then autoOnDeath = data.autoOnDeath end
	if type(data.ffReset) == "boolean" then ffReset = data.ffReset end
	if type(data.binds) == "table" then
		binds.under = data.binds.under or "None"
		binds.above = data.binds.above or "None"
		binds.ret = data.binds.ret or "None"
	end
end

local function sortedNames()
	local t = {}
	for n in pairs(profiles) do table.insert(t, n) end
	table.sort(t)
	return t
end

local function saveToDisk()
	pcall(function()
		if not writefile then return end
		local out = {}
		for k, v in pairs(profiles) do out[k] = v end
		out.__meta = meta
		writefile(CONFIGS_FILE, HttpService:JSONEncode(out))
	end)
end

local function loadFromDisk()
	pcall(function()
		if not (isfile and isfile(CONFIGS_FILE) and readfile) then return end
		local data = HttpService:JSONDecode(readfile(CONFIGS_FILE))
		if type(data) ~= "table" then return end
		if type(data.__meta) == "table" then
			meta.autoLoad = data.__meta.autoLoad == true
			meta.autoLoadName = tostring(data.__meta.autoLoadName or "")
		end
		for k, v in pairs(data) do
			if k ~= "__meta" and type(v) == "table" then profiles[k] = v end
		end
	end)
end

