-- FOV Circle (3-color segmented outline + fill)
local FOV_SEG = 72
local fovLines = {}
local fovTris = {}
local fovRotOffset = 0

for i = 1, FOV_SEG do
    local l = Drawing.new('Line')
    l.Visible = false
    l.Thickness = Options.FOVThickness.Value
    l.ZIndex = 10
    fovLines[i] = l

    local t = Drawing.new('Triangle')
