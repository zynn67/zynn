--- ========== FLOOR (Y-based + following platform) ==========
local BASE_FLOOR_Y = 97.85000610351562
local underFloorOn, underConn, savedY, holdY, platform = false, nil, nil, nil, nil
local aboveOn = false
local PLATFORM_SIZE, FOOT_GAP = Vector3.new(5, 1, 5), 3.05

local function getRoot()
    return LP.Character and LP.Character:FindFirstChild('HumanoidRootPart')
end

local function saveY()
    local root = getRoot()
    if not root then return false end
    savedY = root.Position.Y
    return true
end

local function restoreYOnly()
    local root = getRoot()
    if not root or savedY == nil then return false end
    local p = root.Position
    root.CFrame = CFrame.new(p.X, savedY, p.Z) * (root.CFrame - root.CFrame.Position)
    root.AssemblyLinearVelocity = Vector3.zero
    return true
end

local function destroyPlatform()
    if platform then
        pcall(function() platform:Destroy() end)
        platform = nil
    end
end

local function stopAllFloor()
    underFloorOn, aboveOn = false, false
    if underConn then
        underConn:Disconnect()
        underConn = nil
    end
    destroyPlatform()
    holdY = nil
end

local function ensurePlatform(rootPos)
    if not holdY then return end
    local py = holdY - FOOT_GAP
    if not platform or not platform.Parent then
        local p = Instance.new('Part')
        p.Name = 'UnderPlatform'
        p.Anchored = true
        p.CanCollide = true
        p.CanQuery = false
        p.CanTouch = false
        p.Material = Enum.Material.SmoothPlastic
        p.Color = Color3.fromRGB(255, 140, 0)
        p.Transparency = 0.3
        p.Size = PLATFORM_SIZE
        p.CFrame = CFrame.new(rootPos.X, py, rootPos.Z)
        p.Parent = Workspace
        platform = p
    else
        platform.CFrame = CFrame.new(rootPos.X, py, rootPos.Z)
    end
end

local function startHold(y, isAbove)
    -- don't call stopAllFloor here (would wipe holdY); only reset connection
    if underConn then underConn:Disconnect() underConn = nil end
    holdY = y
    underFloorOn = not isAbove
    aboveOn = isAbove

    local root = getRoot()
    if root then ensurePlatform(root.Position) end

    underConn = RunService.Heartbeat:Connect(function()
        if not holdY then return end
        local r = getRoot()
        if not r then return end
        r.CFrame = CFrame.new(r.Position.X, holdY, r.Position.Z) * (r.CFrame - r.CFrame.Position)
        local v = r.AssemblyLinearVelocity
        r.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z) -- keep horizontal move, kill vertical
        ensurePlatform(r.Position) -- follows under + above
    end)
end

local function toggleUnderFloor()
    local root = getRoot()
    if not root then return end
    if not saveY() then return end

    local underOffset = (Options.UnderOffset and Options.UnderOffset.Value) or 5
    underOffset = math.clamp(underOffset, 1, 60)

    local y = BASE_FLOOR_Y - underOffset
    root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z)
    root.AssemblyLinearVelocity = Vector3.zero
    startHold(y, false)
end

local function floorAbove()
    local root = getRoot()
    if not root then return end
    if not saveY() then return end

    local aboveOffset = (Options.AboveOffset and Options.AboveOffset.Value) or 10
    aboveOffset = math.clamp(aboveOffset, 1, 60)

    local y = BASE_FLOOR_Y + aboveOffset
    root.CFrame = CFrame.new(root.Position.X, y, root.Position.Z)
    root.AssemblyLinearVelocity = Vector3.zero
    startHold(y, true)
end

local function returnPos()
    stopAllFloor()
    restoreYOnly()
end

-- Linoria wiring (toggle, not hold)
if Toggles.FloorUnder then
