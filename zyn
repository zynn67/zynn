		teamL.Font = Enum.Font.Arial
		teamL.TextSize = 12
		teamL.TextXAlignment = Enum.TextXAlignment.Left
		teamL.Parent = row

		makeBtn(row, "View", -150, Color3.fromRGB(255, 140, 0), Color3.fromRGB(0, 0, 0), function()
			toggleView(plr)
		end)
		makeBtn(row, "TP", -100, Color3.fromRGB(255, 140, 0), Color3.fromRGB(0, 0, 0), function()
			local root = getRoot()
			local t = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
			if root and t then
				root.CFrame = t.CFrame + Vector3.new(0, 3, 0)
				notify("TP to " .. plr.DisplayName)
			end
		end)
		makeBtn(row, "Select", -50, Color3.fromRGB(70, 70, 70), Color3.fromRGB(255, 255, 255), function()
			selectedFlingTarget = plr
			flingTarget = plr
			selectedLabel.Text = "Selected: " .. plr.DisplayName
			notify("Selected " .. plr.DisplayName)
		end)
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then addPlayerRow(plr) end
	end

	Players.PlayerAdded:Connect(function(plr)
		if plr ~= player and pgui and pgui.Parent then
			task.wait(0.3)
			if pgui and pgui.Parent then addPlayerRow(plr) end
		end
	end)

	task.spawn(function()
		while pgui and pgui.Parent do
			task.wait(1)
			if not (pgui and pgui.Parent) then break end
			local scroll = pgui:FindFirstChild("Main") and pgui.Main:FindFirstChildOfClass("ScrollingFrame")
			if not scroll then break end
			for _, child in ipairs(scroll:GetChildren()) do
				if child:IsA("Frame") then child:Destroy() end
			end
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player then addPlayerRow(plr) end
			end
		end
	end)

	pguiVisible = true
	return sg
end

local function togglePGui()
	if pgui and pgui.Parent then
		local frame = pgui:FindFirstChild("Main")
		if frame then
			pguiVisible = not frame.Visible
			frame.Visible = pguiVisible
			notify(pguiVisible and "PGui opened" or "PGui closed")
			return
		end
	end
	buildPGui()
	notify("PGui opened")
end

