    ToolPropertiesFolder = shared and shared:WaitForChild('ToolProperties', 5)
end)

local gunModTools = setmetatable({}, { __mode = 'k' })   -- tool -> { FireRate, AutoFire }
local gunModProps = {}                                   -- gun name -> { FireRate, AutoFire }

local function gunModManual()
    return Toggles.GunModEnabled and Toggles.GunModEnabled.Value == true
        and (Toggles.FireRateApplyManual == nil or Toggles.FireRateApplyManual.Value == true)
end

local function gunModRate()
    return (Options.GunModFireRate and Options.GunModFireRate.Value) or 0.01
end

-- Ragebot cadence only shortens when Gun Mod + Fast Firerate + Apply To RageBot are all on
calculateModifiedFireRate = function(toolName, baseRate)
    if not (Toggles.GunModEnabled and Toggles.GunModEnabled.Value) then return baseRate end
    if not (Toggles.GunModFastFire and Toggles.GunModFastFire.Value) then return baseRate end
    if not (Toggles.FireRateApplyRage == nil or Toggles.FireRateApplyRage.Value) then return baseRate end
    if not GUN_MOD_NAMES[toolName] then return baseRate end
    return math.max(0.001, gunModRate())
end

local function applyGunMod(tool)
    if not tool or not tool:IsA('Tool') then return end
    if not GUN_MOD_NAMES[tool.Name] then return end
    if not gunModManual() then return end

    local auto = (Toggles.GunModAutoFire and Toggles.GunModAutoFire.Value) == true

    if gunModTools[tool] == nil then
        gunModTools[tool] = {
            FireRate = tool:GetAttribute('FireRate'),
            AutoFire = tool:GetAttribute('AutoFire'),
        }
    end

    tool:SetAttribute('AutoFire', auto)

    if Toggles.GunModFastFire and Toggles.GunModFastFire.Value then
        local rate = gunModRate()
        tool:SetAttribute('FireRate', rate)

        if ToolPropertiesFolder then
            pcall(function()
                local moduleScript = ToolPropertiesFolder:FindFirstChild(tool.Name)
                if not moduleScript then return end
                local props = require(moduleScript)
                if gunModProps[tool.Name] == nil then
                    gunModProps[tool.Name] = {
                        FireRate = props.FireRate,
                        AutoFire = props.AutoFire,
                    }
                end
                props.FireRate = rate
                props.AutoFire = auto
            end)
        end
    end
end

local function restoreGunMod(tool)
    if not tool or not tool:IsA('Tool') then return end
    local orig = gunModTools[tool]
    if not orig then return end

    pcall(function()
        tool:SetAttribute('FireRate', orig.FireRate)
        tool:SetAttribute('AutoFire', orig.AutoFire)
    end)

    local saved = gunModProps[tool.Name]
    if saved and ToolPropertiesFolder then
        pcall(function()
            local moduleScript = ToolPropertiesFolder:FindFirstChild(tool.Name)
            if not moduleScript then return end
            local props = require(moduleScript)
            props.FireRate = saved.FireRate
            props.AutoFire = saved.AutoFire
        end)
    end

    gunModTools[tool] = nil
end

