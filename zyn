local function performAutoReload(weapon)
    if not weapon or not weapon.Parent then return end
    if autoReloadBusy[weapon] then return end
    if (weapon:GetAttribute('Local_ReloadSession') or 0) ~= 0 then return end

    local cfg = getConfig and getConfig(weapon) or nil
    local behavior = (cfg and cfg.behavior) or weapon:GetAttribute('Behavior')
    local storedAmmo = weapon:GetAttribute('StoredAmmo')
    if behavior == 'Sniper' and storedAmmo and storedAmmo <= 0 then return end

    autoReloadBusy[weapon] = true

    local reloadTime = weapon:GetAttribute('ReloadTime') or (cfg and cfg.reloadTime) or 1
    local session = tick()
    weapon:SetAttribute('Local_ReloadSession', session)

    task.spawn(function()
        pcall(function() FuncReload:InvokeServer() end)
    end)

    task.delay(reloadTime, function()
        if weapon:GetAttribute('Local_ReloadSession') == session then
            if behavior == 'Sniper' then
                local currentAmmo = weapon:GetAttribute('Local_CurrentAmmo') or 0
                local maxAmmo = weapon:GetAttribute('MaxAmmo') or 1
                if currentAmmo < maxAmmo then
                    weapon:SetAttribute('Local_CurrentAmmo', 1)
                    updateHudAmmo(weapon, 1, getConfig and getConfig(weapon) or cfg)
                end
            else
                local maxAmmo = weapon:GetAttribute('MaxAmmo') or (cfg and cfg.maxAmmo) or 0
                weapon:SetAttribute('Local_CurrentAmmo', maxAmmo)
                updateHudAmmo(weapon, maxAmmo, getConfig and getConfig(weapon) or cfg)
            end
            weapon:SetAttribute('Local_ReloadSession', 0)
        end
        autoReloadBusy[weapon] = nil
    end)
end

RunService.Heartbeat:Connect(function()
    if not (Toggles.AutoReload and Toggles.AutoReload.Value) then return end
    local weapon = equippedGunMod()
    if not weapon then return end
    local currentAmmo = weapon:GetAttribute('Local_CurrentAmmo') or 0
    local reloadSession = weapon:GetAttribute('Local_ReloadSession') or 0
    if currentAmmo > 0 or reloadSession ~= 0 then return end
    performAutoReload(weapon)
end)

