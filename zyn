-- Auto Detect Cheaters Background Engine
do
    local playerTrack = {}
    local cheaterRayParams = RaycastParams.new()
    cheaterRayParams.FilterType = Enum.RaycastFilterType.Exclude
    cheaterRayParams.IgnoreWater = true

    task.spawn(function()
        while true do
