    if _G.LithiumBatteryCleanupChinahat then pcall(_G.LithiumBatteryCleanupChinahat) end
    if _G.LithiumBatteryCleanupOptimizer then pcall(_G.LithiumBatteryCleanupOptimizer) end
    if _G.LithiumBatteryCleanupTargetHUD then pcall(_G.LithiumBatteryCleanupTargetHUD) end
    if _G.LithiumBatteryCleanupKillfeed then pcall(_G.LithiumBatteryCleanupKillfeed) end
    if _G.LithiumBatteryCleanupViewmodel then pcall(_G.LithiumBatteryCleanupViewmodel) end
    for i = 1, FOV_SEG do
        fovLines[i]:Remove()
        fovTris[i]:Remove()
    end
    for i = 1, 4 do
        if crosshairLines and crosshairLines[i] then pcall(function() crosshairLines[i]:Remove() end) end
    end
    for i = 1, AR_SEG do
        arLines[i]:Remove()
        arTris[i]:Remove()
    end
    for _, obj in pairs(espObjects) do
        if obj.cleanup then pcall(obj.cleanup) end
    end
    for k in pairs(espObjects) do espObjects[k] = nil end
    if ESPFolder then for _, child in ESPFolder:GetChildren() do child:Destroy() end end
    if crosshairDot then pcall(function() crosshairDot:Remove() end) end
    if crosshairRing then pcall(function() crosshairRing:Remove() end) end
    if rageIndicatorText then rageIndicatorText:Remove() end
    if cleanupParticles then pcall(cleanupParticles) end
    if cleanupHitmarkers then pcall(cleanupHitmarkers) end
    if targetEspGui then pcall(function() targetEspGui:Destroy() end) end
    if activeHitNumbers then
        for _, hn in ipairs(activeHitNumbers) do
            pcall(function() hn.drawing:Remove() end)
        end
        activeHitNumbers = {}
    end
    UserInputService.MouseIconEnabled = true
end)

